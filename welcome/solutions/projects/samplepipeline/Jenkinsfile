pipeline {
  agent any

  parameters {
    string(name: 'REMOTE_IP', defaultValue: '35.87.81.224', description: 'Public IP of the lab server (for manual QA)')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    // נתיבים כפי שהם קיימים אצלך בריפו
    PYENV_HOME   = "${WORKSPACE}/welcome/app/flask-volt-dashboard/.pyenv"
    PROJECT_HOME = "${WORKSPACE}/welcome/app/flask-volt-dashboard"

    // Flask env
    FLASK_APP = 'run.py'
    FLASK_ENV = 'development'
    APP_PORT  = '5001'   // שנה ל-5000 אם זה מה שנדרש אצלך
  }

  stages {
    stage('Clone Flask Project') {
      steps {
        // אם אתה רוצה לעבוד מה-fork שלך – החלף ל-SSH של הריפו שלך.
        // זה מה שעשית בשיעור: למשוך את תכולת המעבדה מ-repo המקורי.
        git branch: 'jenkins-workshop', url: 'https://github.com/yanivomc/devopshift-welcome.git'
      }
    }

    stage('Setup Python venv & Install Deps') {
      steps {
        dir("${PROJECT_HOME}") {
          sh '''#!/bin/bash
            set -euxo pipefail

            PYTHON_BIN="$(command -v python3 || true)"
            if [ -z "$PYTHON_BIN" ]; then
              echo "python3 not found in PATH"; exit 127
            fi
            echo "Using python: $PYTHON_BIN"

            # venv מובנה – לא צריך virtualenv
            rm -rf "$PYENV_HOME"
            "$PYTHON_BIN" -m venv "$PYENV_HOME"

            # הפעלת venv והתקנת תלויות
            . "$PYENV_HOME/bin/activate"
            python -m pip install --upgrade pip setuptools wheel
            python -m pip install -r requirements.txt
          '''
        }
      }
    }

    stage('Run Flask Application') {
      steps {
        dir("${PROJECT_HOME}") {
          sh '''#!/bin/bash
            set -e
            . "$PYENV_HOME/bin/activate"

            # עצור תהליכי Flask קודמים אם יש
            tasks=$(pgrep -f "flask run" || true)
            if [ -n "$tasks" ]; then
              echo "Stopping existing Flask application: $tasks"
              kill -9 $tasks || true
            fi

            echo "Starting Flask on 0.0.0.0:${APP_PORT} ..."
            nohup flask run --host=0.0.0.0 --port="${APP_PORT}" > flask_app.log 2>&1 &
          '''
        }
      }
    }

    stage('Smoke Test (local)') {
      steps {
        dir("${PROJECT_HOME}") {
          sh '''#!/bin/bash
            set -e
            sleep 5
            # ודא שהתהליך חי
            pgrep -f "flask run" >/dev/null
            # ודא שהאפליקציה מגיבה בלוקאל־הסוכן
            curl -sSf "http://127.0.0.1:${APP_PORT}" >/dev/null
            echo "Flask responded OK on ${APP_PORT}"
          '''
        }
      }
    }

    stage('Manual QA Gate') {
      steps {
        script {
          timeout(time: 15, unit: 'MINUTES') {
            def choice = input message: "Open http://${params.REMOTE_IP}:${env.APP_PORT} . Is the app OK?",
                                parameters: [choice(name: 'Proceed', choices: 'Proceed\nAbort', description: 'QA gate')]
            env.USER_CHOICE = choice
          }
        }
      }
    }

    stage('Automated Tests') {
      when { expression { env.USER_CHOICE == 'Proceed' } }
      steps {
        echo 'Running automated tests...'
        // כאן תוכל לשלב pytest וכו'
      }
    }

    stage('If QA Aborted') {
      when { expression { env.USER_CHOICE == 'Abort' } }
      steps {
        script { error 'Pipeline aborted by the user' }
      }
    }

    stage('Finalize') {
      steps {
        script {
          if (env.USER_CHOICE == 'Proceed') {
            echo 'QA approved. Pipeline completed successfully.'
          } else {
            echo 'Pipeline aborted by the user.'
          }
        }
      }
    }
  }

  post {
    always {
      dir("${PROJECT_HOME}") {
        echo 'Cleaning up...'
        sh '''#!/bin/bash
          tasks=$(pgrep -f "flask run" || true)
          [ -n "$tasks" ] && kill -9 $tasks || true
        '''
        archiveArtifacts artifacts: 'flask_app.log', onlyIfSuccessful: false, allowEmptyArchive: true
        sh 'rm -rf "$PYENV_HOME" || true'
      }
      // אם מותקן לך Workspace Cleanup אפשר גם:
      // cleanWs()
    }
  }
}